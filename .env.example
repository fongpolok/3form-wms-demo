# Copy to .env and fill in. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (WMS stock, users, audit)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=threeform_wms
POSTGRES_USER=threeform
POSTGRES_PASSWORD=change-me

# MongoDB Atlas Local (MES events, search). 27030 is taken on this Mac by fpl-mongo.
MONGO_PORT=27032
MONGO_URI=mongodb://127.0.0.1:27032/?directConnection=true
MONGO_DB=threeform_mes

# Site gateway -> core API shared secret
GATEWAY_TOKEN=change-me-gateway-secret

# Demo account passwords (used by `manage.py seed_demo`)
DEMO_PIC_PASSWORD=change-me-pic
DEMO_EM_PASSWORD=change-me-em

# AI agent (Phase 4). Blank = "Advisor offline", system still works.
DEEPSEEK_API_KEY=

# Encrypts API keys / ERP passwords stored in the database (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
INTEGRATION_KEY=
