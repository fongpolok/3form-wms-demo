# Copy to deploy/.env on the edge box and fill in every value. Never commit deploy/.env.
APP_VERSION=3.5.0
SITE_ADDRESS=wms.factory.local
ALLOWED_HOSTS=wms.factory.local,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://wms.factory.local
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_DB=threeform_wms
POSTGRES_USER=threeform
POSTGRES_PASSWORD=            # long random
MONGO_DB=threeform_mes
GATEWAY_TOKEN=                # long random
INTEGRATION_KEY=              # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DEEPSEEK_API_KEY=             # optional: or enter it later in Settings -> Integrations
